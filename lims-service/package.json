{
  "name": "lims-service",
  "version": "1.0.0",
  "description": "Umbrella LIMS microservice",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "build": "tsc",
    "dev": "concurrently \"npm run watch\" \"npm run serve\"",
    "serve": "nodemon dist/server.js",
    "watch": "tsc --watch",
    "lint": "eslint 'src/**/*.{js,ts}'",
    "format": "prettier --write 'src/**/*.{js,ts,json,md}'",
    "db:migrate": "node -e \"import('./dist/migrations/index.js').then(({ migrations, runMigrations }) => import('./dist/configs/db.sequelize.js').then(({ sequelize }) => runMigrations(sequelize, migrations))).then(() => process.exit(0)).catch(e => { console.error(e); process.exit(1); })\""
  },
  "author": "umbrella",
  "license": "ISC",

  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.3",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "@typescript-eslint/tsconfig-utils": "8.55.0",
    "@typescript-eslint/types": "8.55.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "nodemon": "^3.1.10",
    "picomatch": "4.0.3",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "pg": "^8.21.0",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.8",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  }
}
