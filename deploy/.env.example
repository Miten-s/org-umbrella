# Copy to deploy/.env on the server and fill in real values.
# deploy/.env must never be committed — it is covered by .gitignore.

# --- Postgres ---------------------------------------------------------------
# Generate the password with: openssl rand -base64 24
POSTGRES_USER=umbrella
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Application ------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# Comma-separated allowed origins. Because nginx serves the SPA and proxies the
# APIs from the same origin, the browser makes no cross-origin calls — this is
# only a backstop. Set it to your real public URL.
CORS_ORIGINS=http://YOUR_EC2_PUBLIC_IP
